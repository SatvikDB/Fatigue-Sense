# ============================================================
# FatigueSense AI — .gitignore
# ============================================================

# ── Large raw data files ────────────────────────────────────
data/raw/
Google Cluster.csv
bq-results-*.csv

# ── Processed binary data (large npz/parquet/joblib) ────────
data/processed/*.parquet
data/processed/*.npz
data/processed/*.joblib

# Keep metadata JSON files (small, useful)
!data/processed/windows_metadata.json

# ── Model checkpoints (large binary) ────────────────────────
checkpoints/

# ── TensorBoard / Lightning binary logs ─────────────────────
lightning_logs/
experiments/logs/

# ── Large prediction CSVs ───────────────────────────────────
experiments/results/tft_val_predictions.csv
experiments/results/tft_test_predictions.csv

# ── Python cache ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environment ──────────────────────────────────────
.venv/
venv/
env/

# ── Jupyter ─────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Agent working directory ──────────────────────────────────
.agents/
